SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///fitlife.db
# For PostgreSQL: postgresql+psycopg://user:pass@localhost/fitlife_db

# Gmail SMTP — REQUIRED for welcome emails on signup
# 1. Enable 2-Step Verification on your Google account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# Or put only the password in: instance/mail_secret.txt (see mail_secret.example.txt)
MAIL_DEFAULT_SENDER=your.email@gmail.com
APP_BASE_URL=http://127.0.0.1:5000
FLASK_APP=run.py
FLASK_DEBUG=1
